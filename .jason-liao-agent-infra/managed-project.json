{
  "schema": "jason-agent-infra.managed-delivery-workflow.v2",
  "project_id": "smartsearch",
  "commands": {
    "inspect": {
      "argv": ["python3", "scripts/managed_sync.py", "inspect"],
      "cwd": ".",
      "timeout_seconds": 60,
      "mutates": [],
      "receipt_schema": "jason-smartsearch.managed-sync-inspection.v1"
    },
    "skill_parity": {
      "argv": ["npm", "run", "--silent", "check:skill-parity"],
      "cwd": ".",
      "timeout_seconds": 180,
      "mutates": [],
      "receipt_schema": "jason-smartsearch.managed-sync-parity.v1"
    },
    "packed_smoke": {
      "argv": ["npm", "run", "--silent", "smoke:tarball"],
      "cwd": ".",
      "timeout_seconds": 900,
      "mutates": [],
      "receipt_schema": "jason-smartsearch.managed-sync-packed-smoke.v1"
    },
    "downstream_handoff": {
      "argv": ["python3", "scripts/managed_sync.py", "downstream-handoff"],
      "cwd": ".",
      "timeout_seconds": 180,
      "mutates": [],
      "receipt_schema": "jason-agent-infra.delivery-artifacts.v1"
    },
    "verify_live": {
      "argv": ["python3", "scripts/managed_sync.py", "verify-live"],
      "cwd": ".",
      "timeout_seconds": 300,
      "mutates": [],
      "receipt_schema": "jason-smartsearch.managed-sync-live-verify.v1"
    }
  },
  "stages": [
    {
      "id": "release_inspection",
      "stage": "release_readiness",
      "command": "inspect",
      "depends_on": [],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "committed",
      "error_catalog": ["SS_SYNC_DIRTY_UNSCOPED", "SS_SYNC_BRANCH_MISMATCH"]
    },
    {
      "id": "release_skill_parity",
      "stage": "release_readiness",
      "command": "skill_parity",
      "depends_on": ["release_inspection"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "committed",
      "error_catalog": ["SS_SYNC_SKILL_PARITY_DRIFT"]
    },
    {
      "id": "release_packed_smoke",
      "stage": "release_readiness",
      "command": "packed_smoke",
      "depends_on": ["release_skill_parity"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "committed",
      "error_catalog": ["SS_SYNC_PACKED_SMOKE_FAILED"]
    },
    {
      "id": "downstream_handoff",
      "stage": "downstream_propagation",
      "command": "downstream_handoff",
      "depends_on": ["release_packed_smoke"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "committed",
      "error_catalog": ["SS_SYNC_DOWNSTREAM_HANDOFF_REQUIRED"]
    },
    {
      "id": "functional_verification",
      "stage": "functional_verification",
      "command": "verify_live",
      "depends_on": ["release_packed_smoke"],
      "allowed_mutations": [],
      "failure_policy": "stop_project",
      "verification_level": "live",
      "error_catalog": ["SS_VERIFY_EXTERNAL_GATE_MISSING", "SS_VERIFY_PROVIDER_ERROR"],
      "external_dependencies": [
        "machine-private ~/.config/smart-search/config.json (presence and validation only; secret values never enter argv, output, or receipts)",
        "valid main provider for the machine configuration",
        "profile-declared Grok2API account/session and non-empty model list (full-acceptance gate; ordinary search stays runtime-optional)"
      ],
      "recovery_probe_limit": 1
    }
  ],
  "docs": {
    "guide": ".jason-liao-agent-infra/RUNBOOK.md",
    "errors": ".jason-liao-agent-infra/errors.md"
  },
  "recovery": {
    "owner": "selected Agent Infra platform adapter",
    "restore_authority": "the selected platform profile recovery authority for smart-search-config and anysearch-credentials",
    "generation_requirement": "restore the exact prior profile-approved generation recorded in the platform receipt",
    "post_restore_acceptance": "run the declared functional verification once and require doctor plus the fixed real-search evidence"
  }
}
