{
  "name": "@konbakuyomu/smart-search",
  "version": "0.1.16",
  "description": "CLI-first multi-source web search and Agentic Research Preview with structured evidence workspaces.",
  "license": "MIT",
  "homepage": "https://github.com/konbakuyomu/smartsearch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konbakuyomu/smartsearch.git"
  },
  "bugs": {
    "url": "https://github.com/konbakuyomu/smartsearch/issues"
  },
  "bin": {
    "smart-search": "npm/bin/smart-search.js"
  },
  "files": [
    "npm/",
    "skills/smart-search-cli/**",
    "!skills/smart-search-cli/skills/anysearch/.env",
    "src/smart_search/**/*.py",
    "src/smart_search/assets/research_visualizer/**",
    "src/smart_search/assets/sidecar/**",
    "src/smart_search/assets/skills/smart-search-cli/**",
    "!src/smart_search/assets/skills/smart-search-cli/skills/anysearch/.env",
    "!src/smart_search/**/__pycache__/**",
    "!src/smart_search/**/*.pyc",
    "!src/smart_search/**/*.pyo",
    "pyproject.toml",
    "README.md",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node npm/scripts/postinstall.js",
    "test": "node npm/scripts/test.js",
    "set-version": "node npm/scripts/set-package-version.js",
    "sync:python-version": "node npm/scripts/sync-python-version.js",
    "version": "node npm/scripts/sync-python-version.js && git add pyproject.toml package.json package-lock.json",
    "pack:dry": "npm pack --dry-run",
    "check:skill-parity": "node npm/scripts/check-skill-parity.js",
    "smoke:tarball": "node npm/scripts/smoke-packed-install.js",
    "publish:dry": "npm publish --dry-run --access public"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
